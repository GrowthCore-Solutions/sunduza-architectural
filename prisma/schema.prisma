// Sunduza Architectural & Projects — Prisma Schema v2.0
// Provider  : PostgreSQL on Neon (S5.1, S5.4)
// ORM       : Prisma 5 (S5.9)
// Auth      : NextAuth v5 database sessions via @auth/prisma-adapter (S3.5)
// Migrations: prisma migrate dev (dev) | prisma migrate deploy (CI/prod) (S5.59)
// Locked    : design-docs/SUNDUZA_LOCKED_DESIGN.md — Part 3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl bypasses the connection pooler (PgBouncer) for migrations and
  // introspection. In production (Neon), DATABASE_URL points at the pooled
  // endpoint and DIRECT_URL points at the direct endpoint. In local dev,
  // both can be the same connection string.
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

// EDITOR and VIEWER are reserved for future staff onboarding — no application
// path uses them yet, but having them in the type means we never need a second
// migration when the admin panel grows beyond a single operator.
enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

// Typed values for site_settings. The admin UI renders the right input control
// per type, and the service layer parses on read. New types extend this enum
// without touching the schema of every consumer.
enum SettingValueType {
  STRING
  INTEGER
  BOOLEAN
  JSON
  URL
  EMAIL
  PHONE
}

// S5.9 — Booking lifecycle: PENDING → CONTACTED → CONFIRMED → COMPLETED | REJECTED
enum BookingStatus {
  PENDING
  CONTACTED
  CONFIRMED
  COMPLETED
  REJECTED
}

// Audit trail actions — append-only (S2.62)
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  BOOKING_CREATE
  BOOKING_STATUS_UPDATE
  BOOKING_DELETE
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  CONTACT_MESSAGE_CREATE
  CONTACT_MESSAGE_READ
  SETTINGS_UPDATE
}

// ─── SERVICE ──────────────────────────────────────────────────────────────────
// Admin-managed catalogue of offerings. Replaces the previous free-text
// `booking.service` column with a proper lookup. Bookings keep `service`
// (the slug at submission time, immutable snapshot) AND `serviceId` (live
// FK, may SET NULL if a service is later removed) so historical attribution
// never gets lost.
//
// Adding, renaming, hiding or reordering a service is a row update — no
// migration, no deploy.

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  bookings Booking[]

  // Partial indexes (WHERE deleted_at IS NULL) defined in raw migration:
  //   (is_active, sort_order) — public service-picker list
  @@map("services")
}

// ─── TAG ──────────────────────────────────────────────────────────────────────
// Project tagging. Layered on top of the existing Project.category field —
// category stays as the denormalized primary axis (single value), tags add
// multi-dimensional classification (location, style, status, etc.).

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  color     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  projectTags ProjectTag[]

  @@map("tags")
}

// ─── ATTACHMENT ───────────────────────────────────────────────────────────────
// Polymorphic file scaffold. Today no code path writes here; tomorrow this
// is where multi-image projects, testimonial photos, booking blueprints and
// settings logos all live without yet another join table per entity.
//
// (entity_type, entity_id) follows the same pattern as audit_logs — survives
// soft-delete of the referenced entity by design.

model Attachment {
  id         String    @id @default(cuid())
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  filePath   String    @map("file_path")
  mimeType   String?   @map("mime_type")
  sizeBytes  Int?      @map("size_bytes")
  altText    String?   @map("alt_text")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Partial composite index (entity_type, entity_id, sort_order)
  // WHERE deleted_at IS NULL lives in the raw migration.
  @@map("attachments")
}

// ─── USER ─────────────────────────────────────────────────────────────────────
// Single admin identity. NextAuth adapter-compatible fields included.
// Password: bcrypt hash at cost factor from BCRYPT_ROUNDS env var (S3.3)
// Session: database sessions via sessions table, never JWT (S3.5)

model User {
  id             String    @id @default(cuid())
  email          String    @unique @db.Citext
  password       String
  name           String?
  role           UserRole  @default(ADMIN)
  // Account lockout fields (S3.4 — Layer 2 rate limiting)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  // NextAuth adapter required fields
  emailVerified  DateTime? @map("email_verified")
  image          String?
  // Audit timestamps (S5.10)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  sessions     Session[]
  accounts     Account[]
  auditLogs    AuditLog[]
  siteSettings SiteSettings[]

  // Partial soft-delete indexes are defined in raw SQL (see migration
  // 20260523210000_db_hardening_tier_1). Prisma's @@index syntax does not
  // support WHERE clauses, so partial indexes live in the migration only.
  @@map("users")
}

// ─── ACCOUNT ──────────────────────────────────────────────────────────────────
// NextAuth Prisma adapter — OAuth providers (future v2 use, Credentials-only now)

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ─── SESSION ──────────────────────────────────────────────────────────────────
// Database-backed sessions — deleting a row revokes the session instantly (S3.5)
// One per device per login. Cleaned up on logout or expiry.

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

// ─── VERIFICATION TOKEN ───────────────────────────────────────────────────────
// NextAuth adapter — magic link / email verification (not used in v1)

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── BOOKING ──────────────────────────────────────────────────────────────────
// Core lead entity. Island entity — no FK to User or Project (S5.1).
// Booking is anonymous: visitors submit without an account.
// POPIA: consent_given + consent_given_at required (BR-009).
// Lead score: stored computed value, calculated on creation (S5.19 denormalization).
// UTM: all 5 dimensions captured from query params (marketing attribution).

model Booking {
  id String @id @default(cuid())

  // Idempotency: clients submit a stable key per attempt. Same key within the
  // retention window returns the original record instead of duplicating.
  idempotencyKey String? @unique @map("idempotency_key")

  // Visitor contact (denormalized — no Visitor entity in v1)
  name  String
  email String @db.Citext
  phone String

  // Project details
  // `service`   — immutable slug snapshot of what the visitor selected.
  // `serviceId` — live FK to the services catalogue (SET NULL on service
  //               removal, so historical attribution via `service` survives).
  service     String
  serviceId   String?   @map("service_id")
  location    String
  description String
  meetingDate DateTime? @map("meeting_date")

  // Budget — structured range in cents.
  // `budget`          — kept as the free-text snapshot (historical attribution,
  //                     backward compat while the front-end migrates to the new
  //                     structured fields).
  // `budget_min_cents` / `budget_max_cents` — machine-comparable values for
  //                     sorting, filtering and lead-score weighting. Currency
  //                     defaults to ZAR (South African operations).
  // Both NULL means the visitor chose "no preference / not sure".
  budget         String? // legacy snapshot — do not use for arithmetic
  budgetMinCents BigInt? @map("budget_min_cents")
  budgetMaxCents BigInt? @map("budget_max_cents")
  budgetCurrency String  @default("ZAR") @map("budget_currency") @db.Char(3)

  // Lead management
  status    BookingStatus @default(PENDING)
  leadScore Int?          @map("lead_score")
  adminNotes String?      @map("admin_notes")

  // POPIA legal compliance (BR-009)
  consentGiven   Boolean   @default(false) @map("consent_given")
  consentGivenAt DateTime? @map("consent_given_at")

  // Marketing attribution — 5 UTM dimensions (not a repeating group)
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")
  referrerUrl String? @map("referrer_url")
  landingPage String? @map("landing_page")

  // Technical metadata
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  // Audit timestamps (S5.10)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  serviceRef Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Hot-path indexes are PARTIAL (WHERE deleted_at IS NULL) and live in the
  // raw SQL migration 20260523210000_db_hardening_tier_1. They cover:
  //   (status, created_at DESC) — admin list paginated by status
  //   (status, lead_score DESC) — admin queue sorted by score
  //   (email)                   — duplicate / repeat lead lookup
  //   (created_at DESC)         — global recency
  //   (utm_source)              — marketing attribution rollups
  // Plus (service_id) partial index for service-level rollups, defined in the
  // tier-2a migration. Plus DB-level CHECK constraints on lead_score and
  // consent consistency.
  @@map("bookings")
}

// ─── PROJECT ──────────────────────────────────────────────────────────────────
// Portfolio items — managed entirely by admin CRUD.
// imagePath: must be /images/projects/filename.ext format.
// sortOrder: admin-controlled display order (lower = first).
// isFeatured: show on homepage preview (max 3 recommended).

model Project {
  id          String    @id @default(cuid())
  title       String
  description String
  imagePath   String    @map("image_path")
  category    String?
  sortOrder   Int       @default(0) @map("sort_order")
  isFeatured  Boolean   @default(false) @map("is_featured")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  testimonials Testimonial[]
  // Explicit junction (see ProjectTag below). category stays as the
  // denormalized primary axis; tags add multi-dimensional classification.
  projectTags  ProjectTag[]

  // Partial indexes (WHERE deleted_at IS NULL) defined in raw migration:
  //   (is_featured, sort_order), (sort_order), (category)
  @@map("projects")
}

// ─── PROJECT TAG ──────────────────────────────────────────────────────────────
// Explicit junction between Project and Tag. Replaces the Prisma-implicit
// _ProjectTags so raw SQL queries, BI tools and admin dashboards all see
// self-describing column names (project_id / tag_id) instead of A / B.
//
// Composite primary key enforces uniqueness. Cascades on both sides so the
// join row disappears when either the project or the tag is hard-deleted.

model ProjectTag {
  projectId String   @map("project_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

// ─── TESTIMONIAL ──────────────────────────────────────────────────────────────
// Client reviews. Optional FK to Project — NULL = general business review.
// isActive: show/hide without deleting (soft visibility toggle).
// rating: 1–5, enforced at application layer (Zod) + DB CHECK in migration.

model Testimonial {
  id         String    @id @default(cuid())
  clientName String    @map("client_name")
  review     String
  rating     Int?
  projectId  String?   @map("project_id")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Partial indexes (WHERE deleted_at IS NULL) defined in raw migration:
  //   (is_active), (project_id). Plus CHECK (rating BETWEEN 1 AND 5).
  @@map("testimonials")
}

// ─── CONTACT MESSAGE ──────────────────────────────────────────────────────────
// General inquiries — separate from bookings.
// No UTM capture — not a tracked conversion event in v1.
// read/readAt: admin inbox read-state tracking.

model ContactMessage {
  id             String    @id @default(cuid())
  idempotencyKey String?   @unique @map("idempotency_key")
  name           String
  email          String    @db.Citext
  phone          String?
  message        String
  read           Boolean   @default(false)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Partial index (read, created_at DESC) WHERE deleted_at IS NULL is in the
  // raw migration. Inbox queries always run against active rows.
  @@map("contact_messages")
}

// ─── SITE SETTINGS ────────────────────────────────────────────────────────────
// Key-value runtime configuration. Admin edits through UI — no redeployment.
// Bounded EAV: fewer than 50 keys expected. `valueType` lets the admin UI
// render the right input control (text / number / toggle / URL / JSON editor)
// and the service layer parse on read. `category` groups settings in the UI.
// `isPublic` flags settings that can be shipped to the browser via the public
// API; private settings (API keys, internal flags) stay server-only.

model SiteSettings {
  id          String           @id @default(cuid())
  key         String           @unique
  value       String
  valueType   SettingValueType @default(STRING) @map("value_type")
  category    String?
  isPublic    Boolean          @default(false) @map("is_public")
  description String?
  updatedAt   DateTime         @updatedAt @map("updated_at")
  updatedBy   String?          @map("updated_by")

  user User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isPublic])
  @@map("site_settings")
}

// ─── NOTIFICATION ─────────────────────────────────────────────────────────────
// Outbox queue — v2 ready. Rows inserted on booking/message events.
// v1: rows created but not processed (no sender configured).
// v2: background worker reads sentAt=null and dispatches via Resend/WATI.
// Loose coupling: payload JSONB carries entity reference (not a typed FK).

model Notification {
  id        String    @id @default(cuid())
  type      String
  channel   String
  recipient String
  payload   Json
  sentAt    DateTime? @map("sent_at")
  failedAt  DateTime? @map("failed_at")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  // Worker scan order — oldest pending first.
  @@index([createdAt(sort: Asc)])
  // Additional GIN index on payload (jsonb_path_ops) defined in raw migration
  // so workers can locate rows by entity reference (e.g. booking id) cheaply.
  @@map("notifications")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────
// Immutable event log — every admin and system action recorded here.
// NEVER updated. NEVER deleted. Write-once by design (S2.62).
// No updated_at, no deleted_at — intentional exceptions to S5.10.
// entity_type + entity_id: polymorphic reference — VARCHAR pair, not typed FK.
// Rationale: audit logs must survive deletion of the records they reference.

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  userId     String?     @map("user_id")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
