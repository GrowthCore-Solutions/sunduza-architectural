export default function App() {
  // Theme Dark/Light Core States
  const [isDarkMode, setIsDarkMode] = useState<boolean>(false);
  
  // Custom Color Accent State
  const [activeAccent, setActiveAccent] = useState<SystemConfig['accentColor']>(SYSTEM_CONFIG.accentColor);
  
  // Horizontal Scrolling Grab Mechanics
  const [isScrollingGrabbed, setIsScrollingGrabbed] = useState<boolean>(false);
  const [scrollStartX, setScrollStartX] = useState<number>(0);
  const [scrollLeftOffset, setScrollLeftOffset] = useState<number>(0);
  
  // Dynamic Categories and Live Sandbox states
  const [activeCategoryId, setActiveCategoryId] = useState<string>("all");
  const [sandboxLoadState, setSandboxLoadState] = useState<boolean>(false);
  const [sandboxBadge, setSandboxBadge] = useState<string>("");
  const [sandboxHeadline, setSandboxHeadline] = useState<string>("");
  const [sandboxDescription, setSandboxDescription] = useState<string>("");
  const [sandboxPrimaryBtn, setSandboxPrimaryBtn] = useState<string>("");
  const [sandboxRawCode, setSandboxRawCode] = useState<string>("");
  const [sandboxSizeTag, setSandboxSizeTag] = useState<string>("1.2 kb");
  const [aiPromptValue, setAiPromptValue] = useState<string>("");

  // Mobile Menu toggles
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState<boolean>(false);

  // Status message alerts (Toasts)
  const [toastText, setToastText] = useState<string>("");
  const [toastVisible, setToastVisible] = useState<boolean>(false);

  // Vitals scoring state
  const [vitalsTriggered, setVitalsTriggered] = useState<boolean>(false);
  const [vitalsScoreValues, setVitalsScoreValues] = useState<number[]>([0, 0, 0, 0]);

  // Refs for custom DOM configurations
  const scrollerRef = useRef<HTMLDivElement>(null);
  const sandboxRenderRef = useRef<HTMLDivElement>(null);
  const vitalsSectionRef = useRef<HTMLDivElement>(null);

  // Run initial theme check and system configurations on mount
  useEffect(() => {
    const localTheme = localStorage.getItem('color-theme');
    const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (localTheme === 'dark' || (!localTheme && systemPrefersDark)) {
      setIsDarkMode(true);
      document.documentElement.classList.add('dark');
    } else {
      setIsDarkMode(false);
      document.documentElement.classList.remove('dark');
    }

    // Load Default Sandbox configuration
    const defaultTemplate = SYSTEM_CONFIG.sandboxTemplates.all;
    setSandboxBadge(defaultTemplate.badge);
    setSandboxHeadline(defaultTemplate.headline);
    setSandboxDescription(defaultTemplate.description);
    setSandboxPrimaryBtn(defaultTemplate.primaryBtn);
    setSandboxRawCode(defaultTemplate.code);
  }, []);

  // Sync scroll reveals and dynamic diagnostic timers
  useEffect(() => {
    const handleScrollReveal = () => {
      if (!vitalsSectionRef.current || vitalsTriggered) return;
      const rect = vitalsSectionRef.current.getBoundingClientRect();
      const inView = rect.top <= window.innerHeight * 0.85 && rect.bottom >= 0;
      if (inView) {
        setVitalsTriggered(true);
        triggerVitalsAnimation();
      }
    };

    window.addEventListener('scroll', handleScrollReveal);
    // Trigger initial check
    handleScrollReveal();
    return () => window.removeEventListener('scroll', handleScrollReveal);
  }, [vitalsTriggered]);

  // Animate diagnostics dials
  const triggerVitalsAnimation = () => {
    SYSTEM_CONFIG.vitalsMetrics.forEach((metric, index) => {
      let current = 0;
      const target = metric.value;
      const timer = setInterval(() => {
        if (current >= target) {
          clearInterval(timer);
          setVitalsScoreValues(prev => {
            const next = [...prev];
            next[index] = target;
            return next;
          });
        } else {
          current++;
          setVitalsScoreValues(prev => {
            const next = [...prev];
            next[index] = current;
            return next;
          });
        }
      }, 10);
    });
  };

  // Toast notifier
  const triggerToast = (msg: string) => {
    setToastText(msg);
    setToastVisible(true);
    setTimeout(() => {
      setToastVisible(false);
    }, 3000);
  };

  // Toggle dark theme classes
  const toggleThemeMode = () => {
    if (isDarkMode) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('color-theme', 'light');
      setIsDarkMode(false);
      triggerToast("Clean light theme applied");
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('color-theme', 'dark');
      setIsDarkMode(true);
      triggerToast("Premium dark theme applied");
    }
  };

  // Update dynamic code templates on sandbox changes
  const updateSandboxOutputPreview = () => {
    if (!sandboxRenderRef.current) return;
    const innerHTML = sandboxRenderRef.current.innerHTML;
    const cleanHTML = innerHTML.replace(/\s+/g, ' ').trim();
    setSandboxRawCode(cleanHTML);

    const length = new Blob([cleanHTML]).size;
    setSandboxSizeTag((length / 1000).toFixed(2) + " kb");
  };

  // Switch category states
  const handleCategorySelection = (categoryId: string) => {
    setActiveCategoryId(categoryId);
    const template = SYSTEM_CONFIG.sandboxTemplates[categoryId];
    if (!template) return;

    setSandboxLoadState(true);
    setTimeout(() => {
      setSandboxBadge(template.badge);
      setSandboxHeadline(template.headline);
      setSandboxDescription(template.description);
      setSandboxPrimaryBtn(template.primaryBtn);
      setSandboxRawCode(template.code);
      setSandboxLoadState(false);
    }, 500);
  };

  // Custom component inject algorithms inside Sandbox
  const injectNodeToSandbox = (nodeType: 'item' | 'badge') => {
    if (!sandboxRenderRef.current) return;
    if (nodeType === 'item') {
      const div = document.createElement('div');
      div.className = "p-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-500 rounded-xl text-left font-mono hover:border-slate-400 transition-colors m-1 cursor-text";
      div.innerText = "Custom Node Component Module Appended";
      div.setAttribute('contenteditable', 'true');
      sandboxRenderRef.current.appendChild(div);
    } else if (nodeType === 'badge') {
      const span = document.createElement('span');
      span.className = "inline-block px-2 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[10px] font-mono font-bold rounded m-1 cursor-text";
      span.innerText = "NODE ACCENTED";
      span.setAttribute('contenteditable', 'true');
      sandboxRenderRef.current.appendChild(span);
    }
    updateSandboxOutputPreview();
    triggerToast("Workspace element node injected successfully");
  };

  // Copy sandbox config data to clipboard
  const handleConfigCopyToClipboard = () => {
    const textArea = document.createElement("textarea");
    textArea.value = sandboxRawCode;
    document.body.appendChild(textArea);
    textArea.select();
    try {
      document.execCommand('copy');
      triggerToast("Compiled configuration copied successfully");
    } catch {
      triggerToast("Failed to process action data");
    }
    document.body.removeChild(textArea);
  };

  // AI Prompt compiler actions
  const triggerAiCompile = () => {
    const prompt = aiPromptValue.toLowerCase();
    if (prompt.includes('saas') || prompt.includes('grid')) {
      handleCategorySelection('saas');
    } else if (prompt.includes('media') || prompt.includes('portfolio') || prompt.includes('image')) {
      handleCategorySelection('portfolio');
    } else if (prompt.includes('terminal') || prompt.includes('logs') || prompt.includes('stack')) {
      handleCategorySelection('cafe');
    } else if (prompt.includes('checkout') || prompt.includes('transaction')) {
      handleCategorySelection('ecommerce');
    } else if (prompt.includes('tailwind') || prompt.includes('config')) {
      handleCategorySelection('tailwind');
    } else {
      handleCategorySelection('all');
    }
  };

  // Horizontal Scroll Drag-to-Scroll handlers
  const handleScrollMouseDown = (e: MouseEvent<HTMLDivElement>) => {
    if (!scrollerRef.current) return;
    setIsScrollingGrabbed(true);
    setScrollStartX(e.pageX - scrollerRef.current.offsetLeft);
    setScrollLeftOffset(scrollerRef.current.scrollLeft);
  };

  const handleScrollMouseMove = (e: MouseEvent<HTMLDivElement>) => {
    if (!isScrollingGrabbed || !scrollerRef.current) return;
    e.preventDefault();
    const x = e.pageX - scrollerRef.current.offsetLeft;
    const walk = (x - scrollStartX) * 1.5;
    scrollerRef.current.scrollLeft = scrollLeftOffset - walk;
  };

  const stopScrollGrab = () => {
    setIsScrollingGrabbed(false);
  };

  const handleScrollLeft = () => {
    if (scrollerRef.current) {
      scrollerRef.current.scrollBy({ left: -200, behavior: 'smooth' });
    }
  };

  const handleScrollRight = () => {
    if (scrollerRef.current) {
      scrollerRef.current.scrollBy({ left: 200, behavior: 'smooth' });
    }
  };

  // Color Accent mappings
  const accentColorStyles = {
    indigo: {
      text: "text-indigo-600 dark:text-indigo-400",
      bg: "bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600",
      gradient: "from-indigo-500 to-indigo-600",
      border: "border-indigo-500/20",
      ring: "focus:ring-indigo-500",
      dot: "bg-indigo-400"
    },
    emerald: {
      text: "text-emerald-600 dark:text-emerald-400",
      bg: "bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600",
      gradient: "from-emerald-500 to-emerald-600",
      border: "border-emerald-500/20",
      ring: "focus:ring-emerald-500",
      dot: "bg-emerald-400"
    },
    rose: {
      text: "text-rose-600 dark:text-rose-400",
      bg: "bg-rose-600 hover:bg-rose-700 dark:bg-rose-500 dark:hover:bg-rose-600",
      gradient: "from-rose-500 to-rose-600",
      border: "border-rose-500/20",
      ring: "focus:ring-rose-500",
      dot: "bg-rose-400"
    },
    amber: {
      text: "text-amber-600 dark:text-amber-400",
      bg: "bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600",
      gradient: "from-amber-500 to-amber-600",
      border: "border-amber-500/20",
      ring: "focus:ring-amber-500",
      dot: "bg-amber-400"
    },
    blue: {
      text: "text-blue-600 dark:text-blue-400",
      bg: "bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600",
      gradient: "from-blue-500 to-blue-600",
      border: "border-blue-500/20",
      ring: "focus:ring-blue-500",
      dot: "bg-blue-400"
    }
  };

  const selectedAccentClass = accentColorStyles[activeAccent];

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-300">
      
      {/* 1. ANNOUNCEMENT TOP BANNER */}
      <div id="announcement-banner" class="bg-slate-900 text-white dark:bg-slate-900 text-xs sm:text-sm py-2 px-4 relative flex items-center justify-between z-50 border-b border-white/5">
        <div class="mx-auto flex items-center gap-2 text-center">
