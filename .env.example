# Copy this file to .env.local for local development (see docs/LOCAL_SETUP.md)

# Database (required) — PostgreSQL only
# In production (Neon), DATABASE_URL points at the pooled (PgBouncer) endpoint
# and DIRECT_URL points at the direct endpoint used by `prisma migrate`.
# In local dev, both may point at the same Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/sunduza
DIRECT_URL=postgresql://user:password@localhost:5432/sunduza

# NextAuth (required) — set at least one secret; both names work with Auth.js v5
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_SECRET=replace-with-at-least-32-random-characters

# Seed script (required for npm run db:seed)
ADMIN_PASSWORD=your-dev-password-only

# Auth tuning
BCRYPT_ROUNDS=12
SESSION_MAX_AGE_SECONDS=2592000

# Admin notifications
# Until a domain is verified at resend.com/domains, Resend's sandbox mode
# rejects any recipient other than the account owner's own address — use
# that address here for local dev, then switch to a real admin@ address
# once a domain is verified.
ADMIN_EMAIL=admin@sunduza.co.za

# Upstash Redis (rate limiting — recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sunduza <notifications@yourdomain.com>

# Cron protection for /api/internal/notify
CRON_SECRET=

# Sentry (optional — monitoring)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
