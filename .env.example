# Database
DATABASE_URL=postgresql://user:password@host:5432/sunduza

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Auth tuning
BCRYPT_ROUNDS=12
SESSION_MAX_AGE_SECONDS=2592000

# Admin notifications
ADMIN_EMAIL=admin@sunduza.co.za

# Upstash Redis (rate limiting — recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sunduza <notifications@yourdomain.com>

# Cron protection for /api/internal/notify
CRON_SECRET=

# Sentry (optional — monitoring)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
